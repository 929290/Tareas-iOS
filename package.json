{
  "name": "pendientes",
  "version": "1.3.0",
  "description": "App de escritorio minimalista para gestionar tareas",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "author": "Pendientes",
  "build": {
    "appId": "com.pendientes.desktop",
    "productName": "Pendientes",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "quick.html",
      "quick.js",
      "theme.js",
      "styles.css",
      "app.js",
      "sync.js",
      "config.js",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Pendientes-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Pendientes-Portable.${ext}"
    }
  }
}